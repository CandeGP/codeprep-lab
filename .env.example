DATABASE_URL="file:./dev.db"
# Tu API key de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
# Modelo para el tutor IA
ANTHROPIC_MODEL="claude-opus-5-5"
# "true" si lo sirves por HTTPS (p. ej. Tailscale Funnel)
COOKIE_SECURE="false"
# Usuarios (separados por coma) que ven el panel de usuarios en Configuración
ADMIN_USERNAMES=""

# --- Despliegue en Vercel (déjalas vacías en local) ---
# Turso: si TURSO_DATABASE_URL tiene valor se usa en lugar del SQLite de DATABASE_URL
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Vercel Blob (privado) para los PDFs; Vercel la agrega sola al conectar el store
BLOB_READ_WRITE_TOKEN=""
